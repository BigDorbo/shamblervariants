<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef ParentName="SV_DriveBase">
    <defName>SV_CantorDrive</defName>
    <label>cantor</label>
    <description>A shambler with glowing eyes and a commanding presence. It heals its own kind and lets out a vile scream that causes nearby foes to flee.</description>
    <comps>
      <li Class="ShamblerVariants.HediffCompProperties_SVCasterDrive">
        <checkInterval>120</checkInterval>
        <casts>
          <li>
            <ability>SV_CantorBloom</ability>
            <searchRadius>24.9</searchRadius>
            <targetWoundedShamblers>true</targetWoundedShamblers>
          </li>
          <li>
            <ability>SV_CantorScream</ability>
            <searchRadius>8.9</searchRadius>
            <targetHostiles>true</targetHostiles>
            <skipIfTargetHas>SV_CantorReeling</skipIfTargetHas>
          </li>
          <li>
            <ability>SV_CantorPresence</ability>
            <selfCast>true</selfCast>
            <requireHostileNear>true</requireHostileNear>
            <hostileNearRadius>14.9</hostileNearRadius>
          </li>
        </casts>
      </li>
</comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="SV_EffectBase">
    <defName>SV_CantorCommand</defName>
    <label>commanded</label>
    <description>Commanded to be faster and more coordinated.</description>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.6</MoveSpeed>
        </statFactors>
        <statOffsets>
          <MeleeHitChance>2</MeleeHitChance>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="SV_DebuffBase">
    <defName>SV_CantorReeling</defName>
    <label>reeling</label>
    <description>What was that awful sound?</description>
    <defaultLabelColor>(0.65, 0.9, 0.93)</defaultLabelColor>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>-4</MeleeHitChance>
          <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Hearing</capacity>
            <offset>-0.5</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

</Defs>
