<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef ParentName="SV_DriveBase" MayRequireAnyOf="Sov.Tenmo,det.venators,det.halffoot,Ludeon.RimWorld.Odyssey,GS_Molong">
    <defName>SV_GloamDrive</defName>
    <label>gloam</label>
    <description>A shambler from the void that exploits pinholes to teleport and copy itself.</description>
    <comps>
      <li Class="ShamblerVariants.HediffCompProperties_SVCasterDrive">
        <casts>
          <li>
            <ability>SV_GloamWalk</ability>
            <searchRadius>24.9</searchRadius>
            <targetHostiles>true</targetHostiles>
            <skipToTarget>true</skipToTarget>
            <arriveRadius>2</arriveRadius>
          </li>
        </casts>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="SV_EffectBase">
    <defName>SV_GloamEcho</defName>
    <label>gloam echo</label>
    <description>A half-formed copy folded out of nothing.</description>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="SV_EffectBase">
    <defName>SV_GloamAnchor</defName>
    <label>gloam anchor</label>
    <description>Tethered to a half-formed copy of itself.</description>
    <hediffClass>ShamblerVariants.Hediff_SVGloamAnchor</hediffClass>
    <duplicationAllowed>false</duplicationAllowed>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

</Defs>
